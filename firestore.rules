rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Doctors collection (Public directory with write access for practice management)
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // 3. Hospitals collection (Public directory & administration)
    match /hospitals/{hospitalId} {
      allow read, write: if true;
    }

    // 4. Appointments collection (Booking and consultation management)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // 5. Prescriptions collection (Digital prescriptions)
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    // 6. Medical Records (Patient health records)
    match /medical_records/{recordId} {
      allow read, write: if true;
    }

    // 7. Notifications (Patient and doctor alerts)
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 8. Slot locks for appointment concurrency protection
    match /slot_locks/{lockId} {
      allow read, write: if true;
    }

    // Default deny any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
